# Substance Designer project files (large binaries)
Ornate_Fabric/*.sbs
Ornate_Fabric/.autosave/
Ornate_Fabric/dependencies/

# Allow documentation in project folders
!Ornate_Fabric/*.md

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak

# Skill packaging output (built by scripts/build-skills.*)
dist/

# Python bytecode cache
__pycache__/
*.pyc
