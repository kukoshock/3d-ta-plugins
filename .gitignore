# Substance Designer project files (large binaries)
Ornamental_Fabric/*.sbs
Ornamental_Fabric/.autosave/
Ornamental_Fabric/dependencies/

# Allow documentation in project folders
!Ornamental_Fabric/*.md

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak

# Skill packaging output (built by scripts/build-skills.*)
dist/

# Python bytecode cache
__pycache__/
*.pyc
